{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/bsmensah-ctrl/DLL-Injection-Lab/raw/main/schemas/report.schema.json",
  "title": "DLL Injection Lab Report",
  "type": "object",
  "required": ["schema_version", "tool", "mode", "inputs", "summary", "findings"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "tool": {
      "type": "object",
      "required": ["name", "version"],
      "properties": {
        "name": { "const": "DLL Injection Lab" },
        "version": { "type": "string" }
      },
      "additionalProperties": false
    },
    "mode": { "enum": ["offline-artifact-only", "synthetic-event-only"] },
    "inputs": {
      "type": "object",
      "properties": {
        "baseline_inventory": { "type": "string" },
        "observed_inventory": { "type": "string" },
        "entry_bytes": { "type": "string" },
        "event_stream": { "type": "string" },
        "scenarios": { "type": "string" }
      },
      "additionalProperties": false,
      "anyOf": [
        { "required": ["baseline_inventory", "observed_inventory"] },
        { "required": ["event_stream", "scenarios"] }
      ]
    },
    "summary": {
      "type": "object",
      "required": ["finding_count", "by_severity", "by_type"],
      "properties": {
        "finding_count": { "type": "integer", "minimum": 0 },
        "event_count": { "type": "integer", "minimum": 0 },
        "by_severity": {
          "type": "object",
          "additionalProperties": { "type": "integer", "minimum": 0 }
        },
        "by_type": {
          "type": "object",
          "additionalProperties": { "type": "integer", "minimum": 0 }
        }
      },
      "additionalProperties": false
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type", "severity", "title", "evidence"],
        "properties": {
          "type": { "type": "string" },
          "severity": { "enum": ["low", "medium", "high"] },
          "title": { "type": "string" },
          "evidence": { "type": "object" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
