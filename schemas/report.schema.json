{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/bsmensah-ctrl/CrossViewLab/raw/main/schemas/report.schema.json",
  "title": "CrossViewLab Report",
  "type": "object",
  "required": ["schema_version", "tool", "mode", "inputs", "summary", "findings"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "tool": {
      "type": "object",
      "required": ["name", "version"],
      "properties": {
        "name": { "const": "CrossViewLab" },
        "version": { "type": "string" }
      },
      "additionalProperties": false
    },
    "mode": { "const": "offline-artifact-only" },
    "inputs": {
      "type": "object",
      "required": ["baseline_inventory", "observed_inventory"],
      "properties": {
        "baseline_inventory": { "type": "string" },
        "observed_inventory": { "type": "string" },
        "entry_bytes": { "type": "string" }
      },
      "additionalProperties": false
    },
    "summary": {
      "type": "object",
      "required": ["finding_count", "by_severity", "by_type"],
      "properties": {
        "finding_count": { "type": "integer", "minimum": 0 },
        "by_severity": {
          "type": "object",
          "additionalProperties": { "type": "integer", "minimum": 0 }
        },
        "by_type": {
          "type": "object",
          "additionalProperties": { "type": "integer", "minimum": 0 }
        }
      },
      "additionalProperties": false
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type", "severity", "title", "evidence"],
        "properties": {
          "type": { "type": "string" },
          "severity": { "enum": ["low", "medium", "high"] },
          "title": { "type": "string" },
          "evidence": { "type": "object" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
